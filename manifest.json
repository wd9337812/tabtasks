{
  "manifest_version": 3,
  "name": "TabTasks — Sidebar To-Do & Page Collector",
  "version": "0.5.1",
  "description": "Capture webpages as tasks. Organize your next step with lists, dates and optional AI via compatible APIs.",
  "author": "you",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "contextMenus"
  ],
  "action": {
    "default_title": "Open TabTasks sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Capture the current page as a task"
    }
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "host_permissions": [
    "https://tabtasks-pro-api.wd933781.workers.dev/*",
    "https://pay-tabtasks.tabplugins.top/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://tabtasks-pro-api.wd933781.workers.dev/*",
      "https://pay-tabtasks.tabplugins.top/*"
    ]
  },
  "homepage_url": "https://tabtasks.tabplugins.top/"
}
